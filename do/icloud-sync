#!/usr/bin/osascript
--
-- icloud-sync — open System Settings on the "Apps syncing to iCloud Drive" pane.
-- Needs Accessibility permission for whatever process invokes it.

-- Part 1: Your original logic to open the iCloud pane
-- even though it opens the window with and error.
tell application "System Settings" to activate
delay 2.0
tell application "System Settings" to reveal anchor "iCloud" of pane id "com.apple.systempreferences.AppleIDSettings*AppleIDSettings"
delay 2.0

-- Part 2: UI Scripting to navigate to the "Apps Syncing" screen
set timeoutSeconds to 2.0
set uiScript to "click UI Element 2 of group 2 of scroll area 1 of group 1 of group 2 of splitter group 1 of group 1 of window \"iCloud\" of application process \"System Settings\""
my doWithTimeout2(uiScript, timeoutSeconds)

on doWithTimeout2(uiScript, timeoutSeconds)
	set endDate to (current date) + timeoutSeconds
	repeat
		try
			run script "tell application \"System Events\"
" & uiScript & "
end tell"
			exit repeat
		on error errorMessage
			if ((current date) > endDate) then
				error "Can not " & uiScript
			end if
		end try
	end repeat
end doWithTimeout2

