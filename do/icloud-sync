tell application "System Events"
	tell process "System Settings"
		-- 1. Wait for and click the "iCloud Drive" row
		set icloudDriveButton to missing value
		repeat 20 times -- Timeout after ~4 seconds
			try
				set icloudDriveButton to (first UI element of group 1 of scroll area 1 of group 1 of group 2 of splitter group 1 of group 1 of window 1 whose name contains "iCloud Drive")
				if exists icloudDriveButton then
					click icloudDriveButton
					exit repeat
				end if
